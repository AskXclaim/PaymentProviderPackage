@page
@model RegisterCardModel
@{
    ViewData["Title"] = "Register Card";
}
<h1>@ViewData["Title"]</h1>

<form method="post" class="row g-3">
    <div class="col-md-6">
        <label asp-for="@Model.CardRegistration.FirstName" class="form-label">@Model.CardRegistration.FirstName</label>
        <input type="text" class="form-control" id="@Model.CardRegistration.FirstName"
               asp-for="CardRegistration.FirstName">
    </div>
    <div class="col-md-6">
        <label asp-for="@Model.CardRegistration.LastName" class="form-label">@Model.CardRegistration.LastName</label>
        <input type="text" class="form-control" id="@Model.CardRegistration.LastName"
               asp-for="CardRegistration.LastName">
    </div>
    <div class="col-md-6">
        <label asp-for="@Model.CardRegistration.Email" class="form-label">@Model.CardRegistration.Email</label>
        <input type="email" class="form-control" id="@Model.CardRegistration.Email" asp-for="CardRegistration.Email">
    </div>
    <div class="col-md-6">
        <label asp-for="@Model.CardRegistration.PhoneNumber"
               class="form-label">@Model.CardRegistration.PhoneNumber</label>
        <input type="tel" class="form-control" id="@Model.CardRegistration.PhoneNumber"
               asp-for="CardRegistration.PhoneNumber">
    </div>
    <div class="col-md-6">
        <label asp-for="@Model.CardRegistration.Address.AddressLineOne"
               class="form-label">@Model.CardRegistration.Address.AddressLineOne</label>
        <input type="text" class="form-control" id="@Model.CardRegistration.Address.AddressLineOne"
                asp-for="CardRegistration.Address.AddressLineOne">
    </div>
    <div class="col-md-6">
        <label asp-for="@Model.CardRegistration.Address.AddressLineTwo"
               class="form-label">@Model.CardRegistration.Address.AddressLineTwo</label>
        <input type="text" class="form-control" id="@Model.CardRegistration.Address.AddressLineTwo"
               asp-for="CardRegistration.Address.AddressLineTwo">
    </div>
    <div class="col-md-6">
        <label asp-for="@Model.CardRegistration.Address.City"
               class="form-label">@Model.CardRegistration.Address.City</label>
        <input type="text" class="form-control" id="@Model.CardRegistration.Address.City"
               asp-for="@Model.CardRegistration.Address.City" >
    </div>
    <div class="col-md-4">
        <label asp-for="@Model.CardRegistration.Address.County"
               class="form-label">@Model.CardRegistration.Address.County</label>
        <select id="@Model.CardRegistration.Address.County" class="form-select">
            <option selected>Choose a county...</option>
            <option>Leeds</option>
        </select>
    </div>
    <div class="col-md-2">
        <label asp-for="@Model.CardRegistration.Address.Postcode"
               class="form-label">@Model.CardRegistration.Address.Postcode</label>
        <input asp-for="CardRegistration.Address.Postcode" type="text" class="form-control" id="@Model.CardRegistration.Address.Postcode">
    </div>
    <div class="col-12 ">
        <button type="submit" class="btn btn-primary float-end">Register</button>
    </div>
</form>
