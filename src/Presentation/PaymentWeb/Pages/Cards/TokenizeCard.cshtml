@page
@model TokenizeCard
@inject IConfiguration Config
@{
    ViewData["Title"] = "Tokenize Card";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="row">
        @{
            if (string.IsNullOrWhiteSpace(Model.PaymentProviderId))
            {
                <div class="col">
                    An error occurred while trying to display payment collection
                </div>
            }
            else
            {
                <div id="flow-container"></div>
                
            }
        }
    </div>
</div>

@section Scripts {
    <script src="https://checkout-web-components.checkout.com/index.js"></script>
    <script type="module">
        // import "https://checkout-web-components.checkout.com/index.js";
        import mountFlow from "../js/checkoutFlow.js";

        window.onload = async () => {
            await mountFlow("@Config["publicKey"]",@Html.Raw(TempData["paymentSession"]));
        }
        
    </script>
}
